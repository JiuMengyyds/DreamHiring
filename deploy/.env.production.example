# Copy to /etc/dreamhiring/dreamhiring.env and set secure values.
# Never commit the completed file.
DREAMHIRING_DB_URL=jdbc:mysql://127.0.0.1:3306/dream_hiring?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DREAMHIRING_DB_USERNAME=dreamhiring
DREAMHIRING_DB_PASSWORD=replace-with-strong-password
DREAMHIRING_DB_POOL_SIZE=20
DREAMHIRING_DB_MIN_IDLE=5

DREAMHIRING_REDIS_HOST=127.0.0.1
DREAMHIRING_REDIS_PORT=6379
DREAMHIRING_REDIS_PASSWORD=replace-with-redis-password

DREAMHIRING_RABBITMQ_HOST=127.0.0.1
DREAMHIRING_RABBITMQ_PORT=5672
DREAMHIRING_RABBITMQ_USERNAME=dreamhiring
DREAMHIRING_RABBITMQ_PASSWORD=replace-with-rabbitmq-password
DREAMHIRING_RABBITMQ_VHOST=/

DREAMHIRING_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
DREAMHIRING_OSS_BUCKET=replace-with-private-bucket
DREAMHIRING_OSS_ACCESS_KEY_ID=replace-with-access-key-id
DREAMHIRING_OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
DREAMHIRING_OSS_PUBLIC_BASE_URL=https://cdn.example.com
DREAMHIRING_OSS_SIGNED_URL_SECONDS=900

DREAMHIRING_JWT_SECRET=replace-with-at-least-32-random-bytes
DREAMHIRING_CORS_ALLOWED_ORIGINS=https://dreamhiring.example.com
DREAMHIRING_SERVER_ADDRESS=127.0.0.1
DREAMHIRING_SERVER_PORT=8080
DREAMHIRING_LOG_FILE=/var/log/dreamhiring/backend.log
