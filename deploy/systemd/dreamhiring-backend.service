[Unit]
Description=DreamHiring backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dreamhiring
Group=dreamhiring
WorkingDirectory=/opt/dreamhiring
EnvironmentFile=/etc/dreamhiring/dreamhiring.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai -jar /opt/dreamhiring/backend.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/dreamhiring

[Install]
WantedBy=multi-user.target
