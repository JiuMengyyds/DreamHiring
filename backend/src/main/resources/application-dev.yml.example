# 复制为 application-dev.yml 并填写真实配置，application-dev.yml 不进入版本库。
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/dream_hiring?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: dreamhiring
    password: change-me
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: 127.0.0.1
      port: 6379

  rabbitmq:
    host: 127.0.0.1
    port: 5672
    username: guest
    password: guest

storage:
  oss:
    endpoint: https://oss-cn-hangzhou.aliyuncs.com
    bucket: change-me
    access-key-id: change-me
    access-key-secret: change-me
